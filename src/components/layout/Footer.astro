---
import company from "../../data/company.json";
import { siteConfig } from "../../../site.config";
import Container from "../ui/Container.astro";

const year = new Date().getFullYear();
---

<footer class="bg-[var(--color-ink)] text-white">
  <Container class="grid gap-12 py-16 md:grid-cols-[1.7fr_1fr_1.2fr]">
    <div>
      <img src={company.logo} alt={`${company.name} logo`} width="260" height="80" class="h-12 w-auto rounded bg-white p-1.5" />
      <p class="mt-6 max-w-md text-sm leading-7 text-white/65">{company.description}</p>
    </div>
    <div>
      <h2 class="text-sm font-bold uppercase tracking-[0.16em] text-[var(--color-accent)]">Explore</h2>
      <ul class="mt-5 space-y-3 text-sm text-white/75">
        {siteConfig.navigation.map((item) => <li><a class="hover:text-white" href={item.href}>{item.label}</a></li>)}
      </ul>
    </div>
    <div>
      <h2 class="text-sm font-bold uppercase tracking-[0.16em] text-[var(--color-accent)]">Talk to ZBPOWER</h2>
      <ul class="mt-5 space-y-3 text-sm text-white/75">
        <li><a class="hover:text-white" href="/contact/">Request a project review</a></li>
        <li>{company.location}</li>
        <li>OEM / ODM battery manufacturing</li>
      </ul>
    </div>
  </Container>
  <div class="border-t border-white/10">
    <Container class="flex flex-col gap-2 py-6 text-xs text-white/50 sm:flex-row sm:justify-between">
      <p>© {year} {company.name} All rights reserved.</p>
      <p>Lithium battery packs for e-mobility and energy storage</p>
    </Container>
  </div>
</footer>
