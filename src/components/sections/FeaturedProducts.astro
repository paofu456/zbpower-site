---
import { getPublishedProducts } from "../../lib/products";
import ProductCard from "../product/ProductCard.astro";
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";

const products = (await getPublishedProducts()).filter((product) => product.data.featured).slice(0, 3);
---

<section class="border-y border-[var(--color-line)] bg-white py-20 sm:py-24">
  <Container>
    <div class="flex flex-col items-start justify-between gap-8 sm:flex-row sm:items-end">
      <SectionHeading
        eyebrow="Product platforms"
        title="Three battery platforms. One manufacturing partner."
        description="Choose a starting point for your application. Each platform can be reviewed for OEM or ODM development."
      />
      <Button href="/products/" variant="secondary" class="shrink-0">View all products</Button>
    </div>
    <div class="mt-12 grid gap-5 md:grid-cols-3">
      {products.map((product) => <ProductCard product={product} />)}
    </div>
  </Container>
</section>
