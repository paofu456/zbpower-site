---
const stats = [
  ["14", "years of battery manufacturing"],
  ["14,000㎡", "production base"],
  ["2,000+", "battery packs per day"],
  ["20+", "countries and regions served"],
];
---

<section class="bg-white">
  <div class="mx-auto grid max-w-7xl grid-cols-2 gap-px bg-[var(--color-line)] md:grid-cols-4">
    {stats.map(([value, label]) => (
      <div class="bg-white px-6 py-9 sm:px-8">
        <p class="text-3xl font-extrabold tracking-tight text-[var(--color-primary)] sm:text-4xl">{value}</p>
        <p class="mt-2 text-xs font-bold uppercase leading-5 tracking-[0.12em] text-[var(--color-muted)]">{label}</p>
      </div>
    ))}
  </div>
</section>
