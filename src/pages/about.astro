---
import ContactCta from "../components/sections/ContactCta.astro";
import Container from "../components/ui/Container.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { makePageTitle } from "../lib/seo";
---

<BaseLayout
  title={makePageTitle("Manufacturing")}
  description="Learn about ZBPOWER's battery manufacturing base, product platforms, production capacity and OEM/ODM cooperation."
  image="/media/company/factory-floor.jpg"
>
  <section class="border-b border-[var(--color-line)] bg-white py-20 sm:py-24">
    <Container class="grid items-end gap-10 lg:grid-cols-[1.1fr_.9fr]">
      <div>
        <p class="eyebrow mb-5">Manufacturing profile</p>
        <h1 class="max-w-4xl text-5xl font-extrabold leading-[1.05] sm:text-7xl">A battery manufacturing partner since 2012.</h1>
      </div>
      <p class="max-w-2xl text-lg leading-8 text-[var(--color-muted)] lg:justify-self-end">ZBPOWER develops and manufactures lithium battery packs for e-mobility, lead-acid replacement and energy storage, supporting customers from product selection through production.</p>
    </Container>
  </section>

  <section class="py-24 sm:py-28">
    <Container class="grid items-center gap-14 lg:grid-cols-[1.06fr_.94fr] lg:gap-20">
      <img src="/media/company/factory-floor.jpg" alt="ZBPOWER battery production floor in Dongguan" width="2039" height="1252" class="aspect-[4/3] w-full rounded-[1.25rem] object-cover shadow-[var(--shadow-card)]" />
      <div>
        <p class="eyebrow mb-4">The production base</p>
        <h2 class="text-3xl font-extrabold leading-tight sm:text-5xl">Engineering and production in one place.</h2>
        <div class="prose-site mt-6">
          <p>The company was founded in Shenzhen in 2012 and now operates a production base in Dongguan, Guangdong. The site covers more than 14,000㎡ and supports power battery and energy storage production.</p>
          <p>Its team works across battery selection, sample development, testing and volume manufacturing. OEM and ODM projects are reviewed against the final application rather than a generic catalogue part.</p>
        </div>
        <dl class="mt-8 grid grid-cols-2 gap-4">
          <div class="border-t-2 border-[var(--color-primary)] pt-4"><dt class="text-2xl font-extrabold">14 years</dt><dd class="mt-1 text-sm text-[var(--color-muted)]">Battery manufacturing</dd></div>
          <div class="border-t-2 border-[var(--color-primary)] pt-4"><dt class="text-2xl font-extrabold">14,000㎡</dt><dd class="mt-1 text-sm text-[var(--color-muted)]">Production area</dd></div>
          <div class="border-t-2 border-[var(--color-primary)] pt-4"><dt class="text-2xl font-extrabold">3 + 3</dt><dd class="mt-1 text-sm text-[var(--color-muted)]">Power and storage lines</dd></div>
          <div class="border-t-2 border-[var(--color-primary)] pt-4"><dt class="text-2xl font-extrabold">24</dt><dd class="mt-1 text-sm text-[var(--color-muted)]">Technical patents</dd></div>
        </dl>
      </div>
    </Container>
  </section>

  <section class="bg-white py-24 sm:py-28">
    <Container class="grid items-center gap-14 lg:grid-cols-[.96fr_1.04fr] lg:gap-20">
      <div class="grid grid-cols-2 gap-4">
        <img src="/media/company/production-line.jpg" alt="Automated laser welding on a ZBPOWER battery pack" width="1276" height="824" loading="lazy" class="col-span-2 aspect-[16/10] w-full rounded-[1.25rem] object-cover shadow-[var(--shadow-card)]" />
        <img src="/media/company/aging-test-racks.jpg" alt="Battery aging test racks in the ZBPOWER laboratory" width="960" height="865" loading="lazy" class="aspect-square w-full rounded-xl object-cover" />
        <img src="/media/company/warehouse.jpg" alt="Controlled material storage at the ZBPOWER production base" width="1500" height="1000" loading="lazy" class="aspect-square w-full rounded-xl object-cover" />
      </div>
      <div>
        <p class="eyebrow mb-4">Quality &amp; validation</p>
        <h2 class="text-3xl font-extrabold leading-tight sm:text-5xl">Controlled from cell selection to final test.</h2>
        <p class="mt-5 text-lg leading-8 text-[var(--color-muted)]">Production, process control and testing stay close together. Core materials are stored under controlled temperature and humidity, and each stage is checked before the pack moves forward.</p>
        <ul class="mt-8 space-y-4 text-sm leading-6 text-[var(--color-muted)]">
          <li class="border-t border-[var(--color-line)] pt-4"><strong class="text-[var(--color-ink)]">Incoming control</strong> — cell selection, material inspection and traceable supply sources.</li>
          <li class="border-t border-[var(--color-line)] pt-4"><strong class="text-[var(--color-ink)]">Process control</strong> — laser welding, automatic spot welding and in-process checks.</li>
          <li class="border-t border-[var(--color-line)] pt-4"><strong class="text-[var(--color-ink)]">Validation</strong> — more than 600 battery aging test points and finished-product testing.</li>
          <li class="border-t border-[var(--color-line)] pt-4"><strong class="text-[var(--color-ink)]">Quality system</strong> — ISO 9001 quality management, with product certification confirmed by project.</li>
        </ul>
      </div>
    </Container>
  </section>

  <section class="bg-[var(--color-surface)] py-24">
    <Container>
      <div class="max-w-3xl">
        <p class="eyebrow mb-4">What ZBPOWER supports</p>
        <h2 class="text-3xl font-extrabold leading-tight sm:text-5xl">From product platform to production output.</h2>
      </div>
      <div class="mt-10 grid gap-5 lg:grid-cols-3">
        <div class="rounded-[1rem] border border-[var(--color-line)] bg-white p-7">
          <h3 class="text-xl font-extrabold">Product platforms</h3>
          <p class="mt-3 text-sm leading-7 text-[var(--color-muted)]">E-mobility packs, lead-acid replacement batteries and home or commercial storage systems.</p>
        </div>
        <div class="rounded-[1rem] border border-[var(--color-line)] bg-white p-7">
          <h3 class="text-xl font-extrabold">Manufacturing</h3>
          <p class="mt-3 text-sm leading-7 text-[var(--color-muted)]">Power and storage lines, laser welding, aging test points and controlled material storage.</p>
        </div>
        <div class="rounded-[1rem] border border-[var(--color-line)] bg-white p-7">
          <h3 class="text-xl font-extrabold">Quality &amp; validation</h3>
          <p class="mt-3 text-sm leading-7 text-[var(--color-muted)]">Incoming inspection, process testing, finished-product checks and certification support by project.</p>
        </div>
      </div>
    </Container>
  </section>

  <ContactCta />
</BaseLayout>
