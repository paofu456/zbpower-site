---
import Button from "../components/ui/Button.astro";
import Container from "../components/ui/Container.astro";
import company from "../data/company.json";
import BaseLayout from "../layouts/BaseLayout.astro";
import { makePageTitle } from "../lib/seo";

const labelClass = "text-sm font-bold text-[var(--color-ink)]";
const inputClass = "mt-2 block w-full rounded-[0.4rem] border border-[var(--color-line)] bg-white px-4 py-3 text-[var(--color-ink)] outline-none transition focus:border-[var(--color-primary)] focus:ring-2 focus:ring-[color:rgba(10,103,177,0.14)]";
---

<BaseLayout
  title={makePageTitle("Contact")}
  description="Share your battery application and project requirements with ZBPOWER. This preview uses a clearly labelled static form."
>
  <section class="relative overflow-hidden bg-[var(--color-ink)] py-20 text-white sm:py-24">
    <div class="absolute inset-0 opacity-25" aria-hidden="true" style="background-image: radial-gradient(circle at 88% 20%, #28b8e8 0, transparent 30%);"></div>
    <Container class="relative">
      <p class="mb-5 text-xs font-extrabold uppercase tracking-[0.18em] text-[var(--color-accent)]">Start a battery project</p>
      <h1 class="max-w-4xl text-5xl font-extrabold leading-[1.04] sm:text-7xl">Let's scope the right battery platform.</h1>
      <p class="mt-7 max-w-2xl text-xl leading-9 text-white/65">Tell us what the battery will power, the format you have in mind and the market you are targeting.</p>
    </Container>
  </section>

  <section class="py-20 sm:py-24">
    <Container class="grid gap-10 lg:grid-cols-[1.15fr_.85fr] lg:items-start lg:gap-16">
      <div class="rounded-[1.25rem] border border-[var(--color-line)] bg-white p-6 shadow-[var(--shadow-card)] sm:p-9">
        <div class="flex flex-col gap-3 border-b border-[var(--color-line)] pb-6 sm:flex-row sm:items-start sm:justify-between">
          <div>
            <p class="eyebrow">Project inquiry</p>
            <h2 class="mt-3 text-3xl font-extrabold">Tell us about the application.</h2>
          </div>
          <span class="inline-flex w-fit rounded-[0.35rem] bg-[#fff4dc] px-3 py-2 text-[11px] font-extrabold uppercase tracking-[0.12em] text-[#80520b]">Preview form</span>
        </div>

        <p class="mt-6 rounded-[0.45rem] border border-[#f0d9a7] bg-[#fff9eb] px-4 py-3 text-sm leading-6 text-[#6f4b0d]">
          <strong>Preview only:</strong> this form does not send or store your details. A working inbox will be connected before launch.
        </p>

        <form id="preview-inquiry" class="mt-7 grid gap-5 sm:grid-cols-2">
          <div>
            <label for="company-name" class={labelClass}>Company name <span class="text-[var(--color-primary)]">*</span></label>
            <input id="company-name" type="text" required autocomplete="organization" class={inputClass} />
          </div>
          <div>
            <label for="contact-name" class={labelClass}>Your name <span class="text-[var(--color-primary)]">*</span></label>
            <input id="contact-name" type="text" required autocomplete="name" class={inputClass} />
          </div>
          <div>
            <label for="work-email" class={labelClass}>Work email <span class="text-[var(--color-primary)]">*</span></label>
            <input id="work-email" type="email" required autocomplete="email" class={inputClass} />
          </div>
          <div>
            <label for="application" class={labelClass}>Application <span class="text-[var(--color-primary)]">*</span></label>
            <select id="application" required class={inputClass}>
              <option value="">Select an application</option>
              <option>E-bike / cargo bike</option>
              <option>E-motorcycle / moped</option>
              <option>Lead-acid replacement</option>
              <option>Home energy storage</option>
              <option>Commercial / industrial storage</option>
              <option>Other equipment</option>
            </select>
          </div>
          <div class="sm:col-span-2">
            <label for="project-details" class={labelClass}>Project details <span class="text-[var(--color-primary)]">*</span></label>
            <textarea id="project-details" required rows="6" class={inputClass} placeholder="Voltage or format, estimated volume, target market and current stage"></textarea>
          </div>
          <div class="flex flex-col gap-4 sm:col-span-2 sm:flex-row sm:items-center sm:justify-between">
            <p class="text-xs leading-5 text-[var(--color-muted)]">No data leaves this page in the preview.</p>
            <button type="button" id="preview-submit" class="inline-flex min-h-12 items-center justify-center rounded-[0.45rem] bg-[var(--color-primary)] px-6 py-3 text-sm font-bold text-white transition-colors hover:bg-[var(--color-primary-dark)]">Preview submission</button>
          </div>
          <p id="preview-status" role="status" aria-live="polite" hidden class="rounded-[0.45rem] border border-[#b8d8c7] bg-[#eff9f2] px-4 py-3 text-sm font-bold text-[#1f6842] sm:col-span-2"></p>
        </form>
      </div>

      <aside class="space-y-5">
        <div class="rounded-[1.25rem] bg-[var(--color-primary)] p-7 text-white sm:p-8">
          <p class="text-xs font-extrabold uppercase tracking-[0.16em] text-[var(--color-accent)]">Useful to include</p>
          <ul class="mt-5 space-y-4 text-sm leading-6 text-white/78">
            <li class="border-t border-white/15 pt-4">The equipment or storage system the battery will power.</li>
            <li class="border-t border-white/15 pt-4">Voltage, enclosure or fitment requirements already known.</li>
            <li class="border-t border-white/15 pt-4">Target market, expected volume and current project stage.</li>
            <li class="border-t border-white/15 pt-4">Any certification, testing or packaging requirements.</li>
          </ul>
        </div>
        <div class="rounded-[1.25rem] border border-[var(--color-line)] bg-white p-7 sm:p-8">
          <p class="eyebrow">Manufacturing base</p>
          <h2 class="mt-3 text-2xl font-extrabold">{company.location}</h2>
          <p class="mt-3 text-sm leading-7 text-[var(--color-muted)]">ZBPOWER operates a battery production base in Dongguan, Guangdong, with OEM/ODM support for international battery programs.</p>
          <Button href="/about/" variant="text" class="mt-5 px-0">See manufacturing capabilities →</Button>
        </div>
      </aside>
    </Container>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>("#preview-inquiry");
  const submit = document.querySelector<HTMLButtonElement>("#preview-submit");
  const status = document.querySelector<HTMLElement>("#preview-status");

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
  });

  submit?.addEventListener("click", () => {
    if (!form?.reportValidity()) return;
    if (!status) return;
    status.hidden = false;
    status.textContent = "Preview form only — your details were not sent or stored.";
  });
</script>
