---
import ProductCard from "../../components/product/ProductCard.astro";
import ContactCta from "../../components/sections/ContactCta.astro";
import Container from "../../components/ui/Container.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedProducts } from "../../lib/products";
import { makePageTitle } from "../../lib/seo";

const products = await getPublishedProducts();
---

<BaseLayout
  title={makePageTitle("Products")}
  description="Explore ZBPOWER lithium battery platforms for e-mobility, lead-acid replacement and home or commercial energy storage."
>
  <section class="border-b border-[var(--color-line)] bg-white py-20 sm:py-24">
    <Container>
      <p class="eyebrow mb-5">Battery platforms</p>
      <h1 class="max-w-5xl text-5xl font-extrabold leading-[1.05] sm:text-7xl">Battery packs for real applications.</h1>
      <p class="mt-7 max-w-3xl text-xl leading-9 text-[var(--color-muted)]">Start with the platform closest to your product. Final chemistry, format, enclosure and system requirements are confirmed with the ZBPOWER team.</p>
    </Container>
  </section>

  <section class="py-20 sm:py-24">
    <Container>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {products.map((product) => <ProductCard product={product} />)}
      </div>
    </Container>
  </section>

  <ContactCta />
</BaseLayout>
